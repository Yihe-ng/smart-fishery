  "fixture": {
    "type": "candidate_fixture",
    "note": "示例清单：路径指向仓库内正式权重（releases/growth_20260808_v1/），仅为保证 smoke/回归可运行；替换候选时只改本 manifest，且候选权重应放入仓库 releases 目录或使用仓库相对路径。"
  },
  "segmentation": {
    "backend": "ultralytics_seg",
    "path": "app/models/ai/releases/growth_20260808_v1/segmentation.pt",
    "imgsz": 800,
    "conf": 0.35,
    "nms_iou": 0.7,
    "retina_masks": true,
    "mask_policy": "largest_connected_component",
    "class_names": ["fish"],
    "secondary_review_area_ratio": 0.05
  },
  "classifier": {
    "backend": "ultralytics_yolo_cls_t1",
    "path": "app/models/ai/releases/growth_20260808_v1/measurability_classifier.pt",
    "pretrained_path": "app/models/ai/releases/growth_20260808_v1/classifier_backbone.pt",
    "input_size": 224,
